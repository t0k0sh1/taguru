{
  "title": "taguru",
  "uid": "taguru-overview",
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(taguru_http_requests_total[5m])) by (route, status)",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request duration p95 by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(taguru_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "In-flight requests",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "taguru_inflight_requests" }]
    },
    {
      "id": 4,
      "title": "Requests shed (rate limit) total",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "taguru_requests_shed_total" }]
    },
    {
      "id": 5,
      "title": "Build info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "taguru_build_info", "format": "table", "instant": true }
      ]
    },
    {
      "id": 6,
      "title": "Errors by kind",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(taguru_errors_total[5m])) by (kind)",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Search outcomes by op",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(taguru_searches_total[5m])) by (op, outcome)",
          "legendFormat": "{{op}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Retrieval cache hit ratio",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(taguru_retrieval_cache_total{outcome=\"hit\"}[5m])) / sum(rate(taguru_retrieval_cache_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 9,
      "title": "Context disk bytes by file",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "taguru_context_disk_bytes",
          "legendFormat": "{{context}} {{file}}"
        }
      ]
    }
  ]
}
