{
  "name": "taguru",
  "version": "0.9.7",
  "description": "TypeScript/JavaScript client SDK for the Taguru long-term semantic memory server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0k0sh1/taguru.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "taguru",
    "llm",
    "memory",
    "rag",
    "knowledge-graph"
  ],
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup src/index.ts src/testing.ts --format esm,cjs --sourcemap --external @opentelemetry/api && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check:surface": "tsx scripts/check-surface.ts",
    "check:cjs": "node -e \"require('./dist/index.cjs'); require('./dist/testing.cjs');\""
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "oxlint": "^1.93.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
